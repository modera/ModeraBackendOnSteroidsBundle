{
    "name": "modera/backend-on-steroids-bundle",
    "type": "symfony-bundle",
    "description": "Bundle makes it easier to optimize MJR based backend's loading speed for up to 50%.",
    "license": "MIT",
    "authors": [
        {
            "name": "Sergei Lissovski"
        },
        {
            "name": "Sergei Vizel"
        }
    ],
    "require": {
        "php": ">=7.4",
        "modera/expander-bundle": "^5.0|^6.0",
        "modera/mjr-integration-bundle": "^5.0|^6.0"
    },
    "require-dev": {
        "phake/phake": "^4.0",
        "phpunit/phpunit": "^6.5",
        "modera/foundation-bundle": "^5.0",
        "symfony/symfony": "^5.4|^6.0"
    },
    "autoload": {
        "psr-4": { "Modera\\BackendOnSteroidsBundle\\": "" }
    },
    "autoload-dev": {
        "classmap": [
            "Tests/Fixtures/App/app/AppKernel.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        }
    }
}
